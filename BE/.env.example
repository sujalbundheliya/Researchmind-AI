PORT=5000
BACKEND_URL=http://localhost:5000
JWT_SECRET=replace_with_at_least_64_random_hex_chars
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
FASTAPI_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MAX_FILE_SIZE_MB=20
STORAGE_PATH=./uploads
NODE_ENV=development

# ── Stripe billing ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_INDIVIDUAL=price_xxx   # from `npm run stripe:setup`
STRIPE_PRICE_PRO=price_xxx          # from `npm run stripe:setup`
STRIPE_WEBHOOK_SECRET=whsec_xxx     # from `stripe listen` or dashboard

# ── Super admin (seeded via `npm run seed:admin`) ───────────────
SUPER_ADMIN_EMAIL=admin@researchmind.ai
SUPER_ADMIN_PASSWORD=               # blank → a temp password is generated

# ── Contact form ────────────────────────────────────────────────
# Where submissions from /contact are emailed. Messages are ALWAYS stored in
# the contact_messages table and readable in the admin console, so leaving SMTP
# blank is a supported configuration — it just disables outbound email.
CONTACT_EMAIL=
# Gmail requires a 16-char App Password (Google Account > 2FA > App Passwords),
# NOT the account password. Leave blank to keep DB-only mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
